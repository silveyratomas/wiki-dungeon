---
import "../styles/global.css";
const { title } = Astro.props;
const base = import.meta.env.BASE_URL;
// Normalizamos la ruta actual quitando el base para comparar
let rutaActual = Astro.url.pathname;
const baseTrim = base.endsWith("/") ? base.slice(0, -1) : base;
if (baseTrim && rutaActual.startsWith(baseTrim)) {
  rutaActual = rutaActual.slice(baseTrim.length) || "/";
}
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <title>{title}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  </head>

  <body class="bg-black text-white min-h-screen">
    <!-- Imagen de fondo -->
    <div
      class="fixed inset-0 -z-10 bg-cover bg-center"
      style={`background-image: url(${base}bg.png);`}
    >
    </div>

    <!-- Contenido -->
    <div class="min-h-screen py-4 px-2 flex justify-center items-start">
      <div class="max-w-[1440px] w-full mx-auto flex flex-col md:flex-row rounded-2xl bg-[#0e1628e6] backdrop-blur px-2 md:px-6 py-4 md:py-8 shadow-xl">
        <!-- Sidebar -->
        <aside class="w-full md:w-64 md:pr-6 border-b md:border-b-0 md:border-r border-white/10 mb-4 md:mb-0 flex-shrink-0">
          <h1 class="text-2xl md:text-3xl font-extrabold bg-gradient-to-r from-green-400 via-blue-500 to-purple-600 bg-clip-text text-transparent animate-text mb-6 md:mb-10 text-center md:text-left">
            Wiki Dungeon
          </h1>
          <nav class="flex flex-wrap md:block justify-center gap-2 md:gap-0 space-y-0 md:space-y-3 text-white text-base">
            <a href={`${base}contenido/inicio`}
              class={`block px-2 py-1 rounded transition-all duration-200 text-center md:text-left ${
                rutaActual === '/contenido/inicio' ? 'bg-green-400/20 font-semibold' : 'hover:bg-green-400/10'
              }`}>
              Inicio
            </a>
            <a href={`${base}contenido/niveles`}
              class={`block px-2 py-1 rounded transition-all duration-200 text-center md:text-left ${
                rutaActual === '/contenido/niveles' ? 'bg-green-400/20 font-semibold' : 'hover:bg-green-400/10'
              }`}>
              Niveles
            </a>
            <a href={`${base}contenido/crafteos`}
              class={`block px-2 py-1 rounded transition-all duration-200 text-center md:text-left ${
                rutaActual === '/contenido/crafteos' ? 'bg-green-400/20 font-semibold' : 'hover:bg-green-400/10'
              }`}>
              Crafteos
            </a>
            <a href={`${base}contenido/bugs`}
              class={`block px-2 py-1 rounded transition-all duration-200 text-center md:text-left ${
                rutaActual === '/contenido/bugs' ? 'bg-green-400/20 font-semibold' : 'hover:bg-green-400/10'
              }`}>
              Bugs
            </a>
            <a href={`${base}contenido/comandos`}
              class={`block px-2 py-1 rounded transition-all duration-200 text-center md:text-left ${
                rutaActual === '/contenido/comandos' ? 'bg-green-400/20 font-semibold' : 'hover:bg-green-400/10'
              }`}>
              Comandos
            </a>
            <a href={`${base}contenido/warps`}
              class={`block px-2 py-1 rounded transition-all duration-200 text-center md:text-left ${
                rutaActual === '/contenido/warps' ? 'bg-green-400/20 font-semibold' : 'hover:bg-green-400/10'
              }`}>
              Warps
            </a>
          </nav>
        </aside>

        <!-- Contenido principal -->
        <main class="flex-1 pt-2 md:pl-6 max-h-full overflow-y-auto pr-0 md:pr-2 scrollbar-thin scrollbar-thumb-green-500/50">
          <h2 class="text-2xl md:text-3xl font-bold text-green-400 mb-4 md:mb-6">{title}</h2>
          <slot />
        </main>
      </div>
    </div>
    <script type="module" src={`${base}scripts/tooltip.js`}></script>
  </body>
</html>
