---
import "../styles/global.css";
const base = import.meta.env.BASE_URL;
---

<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <title>Wiki Dungeon MyCraft</title>
  </head>

  <body
    class="bg-gradient-to-b from-black via-neutral-900 to-black text-white min-h-screen flex items-center justify-center px-2 py-4"
  >
    <main class="max-w-2xl w-full flex flex-col items-center gap-6">
      <!-- Logo / Imagen -->
      <div class="flex justify-center w-full">
        <img
          src={`${base}Mycraft.png`}
          alt="Logo Wiki Dungeon"
          class="w-32 sm:w-48 md:w-64 animate-pulse drop-shadow-[0_0_1rem_#22c55e]"
        />
      </div>

      <!-- Contenido principal -->
      <div
        class="bg-white/5 backdrop-blur-md border border-white/10 rounded-xl p-4 sm:p-6 md:p-8 shadow-lg w-full"
      >
        <h1
          class="text-2xl sm:text-3xl md:text-4xl font-bold text-green-400 drop-shadow-[0_0_0.3rem_#22c55e] text-center"
        >
          Wiki Dungeon MyCraft
        </h1>
        <p class="mt-3 text-base sm:text-lg text-slate-300 text-center">
          Guía para jugadores nuevos de la modalidad Dungeon.
        </p>
        <p class="mt-2 text-sm text-slate-400 italic text-center">
          “Prepárate para conquistar la Dungeon...”
        </p>
        <div class="mt-6 flex justify-center gap-4 flex-wrap">
          <a
            href={`${base}contenido/inicio`}
            class="px-5 py-2 rounded-md bg-green-500 hover:bg-green-400 text-black font-semibold transition"
          >
            👉 Comenzar
          </a>
        </div>
      </div>
    </main>
  </body>
</html>
