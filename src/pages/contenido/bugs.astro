---
import Layout from "../../layouts/Layout.astro";
const title = "Bugs";
---

<Layout {title}>
    <div class="max-w-xl mx-auto text-center mt-10 px-4">
        <h2 class="text-2xl font-bold text-green-400 mb-4">Bugs</h2>
        <p class="text-base text-white mb-4">
            Reporta aquí cualquier bug o problema que encuentres en la Dungeon.
        </p>
        <p class="text-green-300 mt-6 font-bold italic">
            ¡Tu ayuda mejora el servidor!
        </p>
    </div>
</Layout>
