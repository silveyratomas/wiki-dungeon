---
import Layout from "../../layouts/Layout.astro";
const title = "Warps";
---

<Layout {title}>
    <div class="max-w-xl mx-auto text-center mt-10 px-4">
        <h2 class="text-2xl font-bold text-green-400 mb-4">Warps</h2>
        <p class="text-base text-white mb-4">
            Aquí verás los warps disponibles y cómo acceder a cada zona
            especial.
        </p>
        <p class="text-green-300 mt-6 font-bold italic">
            Próximamente más información sobre warps.
        </p>
    </div>
</Layout>
